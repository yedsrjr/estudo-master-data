@using Domain.Models.ViewModels

@model PedidoViewModel

<div class="container mt-4">
    @using (Html.BeginForm("Edit", "Pedidos", FormMethod.Post))
    {
        <div class="card shadow-sm">
            <div class="card-header" data-bs-toggle="collapse" data-bs-target="#form-header" style="cursor: pointer;">
                <i class="fa fa-chevron-down me-2"></i> Dados do Pedido
            </div>
            <div class="collapse show" id="form-header">
                <div class="card-body">
                    @Html.Raw(ViewBag.ContentHeader)
                    @if (Model?.ErrorAlert != null)
                    {
                        @Html.Raw(Model.ErrorAlert.GetHtml())
                    }
                    <div class="d-flex justify-content-between align-items-center">
                        <input type="hidden" name="codPedido" value="@Model?.CodPedido" />
                        <a></a>
                        <div class="d-flex gap-2">
                            <button type="submit" name="submitAction" value="save" class="btn btn-primary">
                                <i class="bi bi-save"></i> Salvar Dados
                            </button>

                            <button type="submit" name="submitAction" value="send" class="btn btn-success">
                                <i class="fa fa-send"></i> Finalizar Pedido
                            </button>
                        </div>
                    </div>
                    @if (Model?.ValidationAlerts?.Any() == true)
                    {
                        foreach (var alert in Model.ValidationAlerts)
                        {
                            @Html.Raw(alert.GetHtml())
                        }
                    }
                </div>
            </div>
        </div>

        <div class="card shadow-sm mt-3">
            <div class="card-header" data-bs-toggle="collapse" data-bs-target="#form-item" style="cursor: pointer;">
                <i class="fa fa-chevron-down me-2"></i> Itens do Pedido
            </div>
            <div class="collapse show" id="form-item">
                <div class="card-body">
                    @Html.Raw(ViewBag.ContentItem)
                </div>
            </div>
        </div>

        <div class="card shadow-sm mt-3">
            <div class="card-header" data-bs-toggle="collapse" data-bs-target="#form-obs" style="cursor: pointer;">
                <i class="fa fa-chevron-down me-2"></i> Observações cadastradas
            </div>
            <div class="collapse show" id="form-obs">
                <div class="card-body">
                    @Html.Raw(ViewBag.ContentLog)
                </div>
            </div>
        </div>

        <div class="card shadow-sm mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <input type="hidden" name="codPedido" value="@Model?.CodPedido" />
                    <a asp-controller="Pedidos" asp-action="Index" class="btn btn-secondary me-1">
                        <i class="fa-solid fa-left-long"></i> Voltar
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@if (TempData["Mensagem"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Sucesso!',
            text: '@TempData["Mensagem"]',
            confirmButtonText: 'OK'
        });
    </script>
}


<script>
    const swalWithBootstrapButtons = Swal.mixin({
        customClass: {
            confirmButton: "btn btn-success",
            cancelButton: "btn btn-danger"
        },
        buttonsStyling: false
    });

    async function confirmarExclusao(id) {
        const result = await swalWithBootstrapButtons.fire({
            title: "Tem certeza?",
            text: "Você não poderá desfazer esta ação!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Sim, excluir!",
            cancelButtonText: "Não, cancelar!",
            reverseButtons: true
        });

        if (!result.isConfirmed) return;

        try {
            const response = await fetch('@Url.Action("Delete", "PedidoItem")?id=' + encodeURIComponent(id), {
                method: 'POST'
            });

            if (!response.ok) {
                const msg = await response.text();
                throw new Error(msg || `HTTP ${response.status}`);
            }

            await swalWithBootstrapButtons.fire("Excluído!", "Item removido com sucesso.", "success");
            location.reload();
        } catch (err) {
            await swalWithBootstrapButtons.fire("Erro", err.message || "Não foi possível excluir o item.", "error");
        }
    }
</script>