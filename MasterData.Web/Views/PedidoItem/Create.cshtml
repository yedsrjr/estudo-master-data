
<div class="container mt-4">
    @using (Html.BeginForm("CreatePost", "PedidoItem", FormMethod.Post, new { id = "pedidoitem-create-form" }))
    {
        <div class="card shadow-sm">
            <div class="card-body">

                <input type="hidden" name="codPedido" value="@ViewBag.CodPedido" />
                @Html.Raw(ViewBag.Content)

                @if (Model?.ErrorAlert != null)
                {
                    @Html.Raw(Model.ErrorAlert.GetHtml())
                }

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="bi bi-save"></i> Salvar
                    </button>

                    <a href="@Url.Action("Edit", "Pedidos", new { codPedido = ViewBag.CodPedido })" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </a>
                </div>
            </div>
        </div>
    }
</div>

