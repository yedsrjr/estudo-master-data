@using Domain.Models.ViewModels
@model DashboardViewModel

<partial name="_NavBar" />

<div class="min-vh-100 bg-light">
    <div class="container py-5">

        <!-- Cards de Estatísticas -->
        <div class="row g-4 mb-5">

            <div class="col-12 col-md-6 col-lg-4">
                <div class="card shadow-sm border">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Clientes Ativos</p>
                            <p class="h3 fw-bold text-primary mb-0">@Model.ClientCount</p>
                        </div>
                        <div class="rounded d-flex align-items-center justify-content-center"
                             style="width:3rem;height:3rem;background-color:#dbeafe;">
                            <i class="fas fa-users fs-4" style="color:#1d4ed8;"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
                <div class="card shadow-sm border">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Produtos Ativos</p>
                            <p class="h3 fw-bold mb-0" style="color:#7c3aed;">@Model.ProductCount</p>
                        </div>
                        <div class="rounded d-flex align-items-center justify-content-center"
                             style="width:3rem;height:3rem;background-color:#ede9fe;">
                            <i class="bi bi-box-seam-fill fs-4" style="color:#7c3aed;"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
                <div class="card shadow-sm border">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Orçamentos em Aberto</p>
                            <p class="h3 fw-bold text-success mb-0">@Model.OrderCount</p>
                        </div>
                        <div class="rounded d-flex align-items-center justify-content-center"
                             style="width:3rem;height:3rem;background-color:#dcfce7;">
                            <i class="bi bi-file-earmark-text-fill fs-4" style="color:#16a34a;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Seção Pedidos por Status + Filtro -->
        <div class="d-flex justify-content-center mb-5">
            <div class="card shadow-sm border w-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                        <div>
                            <h2 class="h5 fw-semibold text-dark mb-1">
                                Pedidos Cadastrados
                            </h2>

                            <small class="text-muted">
                                Resumo de pedidos por status e período
                            </small>
                        </div>

                        <span class="badge bg-light text-dark border px-3 py-2">
                            Total Geral: R$ @Model.OrdersTotalGeral.ToString("N2")
                        </span>
                    </div>

                    <div class="row g-4">

                        <!-- Tabela de Status -->
                        <div class="col-12 col-lg-7">
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th class="border-0"></th>
                                            <th class="border-0" style="color:#164499;">Status</th>
                                            <th class="text-center border-0" style="color:#164499;">Qtde.</th>
                                            <th class="text-end border-0" style="color:#164499;">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var baseStatuses = new[]
                                            {
                                        new { Id = 1, Cor = "#164499", Desc = "Em Elaboração" },
                                        new { Id = 2, Cor = "#0ea5e9", Desc = "Pedido Enviado" },
                                        new { Id = 3, Cor = "#999999", Desc = "Pedido Cancelado" },
                                        new { Id = 4, Cor = "#dc2626", Desc = "Pedido Reprovado" },
                                        new { Id = 5, Cor = "#f59e0b", Desc = "Faturado" },
                                        new { Id = 6, Cor = "#16a34a", Desc = "Entregue" }
                                    };
                                        }

                                        @foreach (var s in baseStatuses)
                                        {
                                            var item = Model.OrdersByStatus?.FirstOrDefault(x => x.Id == s.Id);
                                            var qtd = item?.Qtd ?? 0;
                                            var total = item?.TotalPedidos ?? 0m;
                                            var status = item?.Status ?? s.Desc;

                                            <tr>
                                                <td style="width: 20px;">
                                                    <div style="background-color:@s.Cor;border-radius:50%;width:12px;height:12px;"></div>
                                                </td>

                                                <td class="fw-medium text-dark">@status</td>

                                                <td class="text-center">
                                                    <span class="badge bg-light text-dark border">@qtd</span>
                                                </td>

                                                <td class="text-end fw-semibold text-success">
                                                    R$ @total.ToString("N2")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Filtro por Período -->
                        <div class="col-12 col-lg-5">
                            <div class="border rounded p-3 bg-light h-100">
                                <h6 class="fw-semibold text-dark mb-3">Filtrar por Período</h6>

                                <form method="get" asp-action="Index">
                                    <div class="row g-2 mb-3">
                                        <div class="col-12 col-sm-5">
                                            <label class="text-muted small mb-1">De</label>
                                            <input type="date" class="form-control form-control-sm" name="de" value="@Context.Request.Query["de"]" />
                                        </div>

                                        <div class="col-12 col-sm-5">
                                            <label class="text-muted small mb-1">Até</label>
                                            <input type="date" class="form-control form-control-sm" name="ate" value="@Context.Request.Query["ate"]" />
                                        </div>

                                        <div class="col-12 col-sm-2 d-flex align-items-end">
                                            <button type="submit" class="btn btn-primary btn-sm w-100">
                                                <i class="fa fa-search"></i>
                                            </button>
                                        </div>
                                    </div>
                                </form>

                                <div class="d-flex flex-wrap gap-2">
                                    <a asp-action="Index"
                                       asp-route-de="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       asp-route-ate="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       class="btn btn-outline-secondary btn-sm">
                                        Hoje
                                    </a>

                                    <a asp-action="Index"
                                       asp-route-de="@DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd")"
                                       asp-route-ate="@DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd")"
                                       class="btn btn-outline-secondary btn-sm">
                                        Ontem
                                    </a>

                                    <a asp-action="Index"
                                       asp-route-de="@DateTime.Today.AddDays(-(int)DateTime.Today.DayOfWeek).ToString("yyyy-MM-dd")"
                                       asp-route-ate="@DateTime.Today.AddDays(6 - (int)DateTime.Today.DayOfWeek).ToString("yyyy-MM-dd")"
                                       class="btn btn-outline-secondary btn-sm">
                                        Semana Atual
                                    </a>

                                    <a asp-action="Index"
                                       asp-route-de="@DateTime.Today.AddDays(-(int)DateTime.Today.DayOfWeek - 7).ToString("yyyy-MM-dd")"
                                       asp-route-ate="@DateTime.Today.AddDays(-(int)DateTime.Today.DayOfWeek - 1).ToString("yyyy-MM-dd")"
                                       class="btn btn-outline-secondary btn-sm">
                                        Semana Anterior
                                    </a>

                                    <a asp-action="Index"
                                       asp-route-de="@(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).ToString("yyyy-MM-dd"))"
                                       asp-route-ate="@(new DateTime(DateTime.Today.Year, DateTime.Today.Month, DateTime.DaysInMonth(DateTime.Today.Year, DateTime.Today.Month)).ToString("yyyy-MM-dd"))"
                                       class="btn btn-outline-secondary btn-sm">
                                        Mês Atual
                                    </a>

                                    <a asp-action="Index"
                                       asp-route-de="@(new DateTime(DateTime.Today.AddMonths(-1).Year, DateTime.Today.AddMonths(-1).Month, 1).ToString("yyyy-MM-dd"))"
                                       asp-route-ate="@(new DateTime(DateTime.Today.AddMonths(-1).Year, DateTime.Today.AddMonths(-1).Month, DateTime.DaysInMonth(DateTime.Today.AddMonths(-1).Year, DateTime.Today.AddMonths(-1).Month)).ToString("yyyy-MM-dd"))"
                                       class="btn btn-outline-secondary btn-sm">
                                        Mês Anterior
                                    </a>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- Ações Rápidas -->
        <div class="d-flex justify-content-center mb-5">
            <div class="card shadow-sm border w-100" style="max-width: 700px;">
                <div class="card-body">
                    <h2 class="h5 fw-semibold text-dark mb-4">Ações Rápidas</h2>
                    <div class="row g-3">

                        <div class="col-12 col-md-6">
                            <a asp-controller="Clientes" asp-action="GetAdd"
                               class="quick-action-btn d-flex align-items-center p-3 rounded text-decoration-none quick-action-blue">
                                <div class="bg-primary rounded d-flex align-items-center justify-content-center me-3 flex-shrink-0"
                                     style="width:2.5rem;height:2.5rem;">
                                    <i class="bi bi-person-plus-fill text-white fs-5"></i>
                                </div>
                                <div>
                                    <p class="fw-medium mb-0 text-dark">Novo Cliente</p>
                                    <small class="text-muted">Criar novo cliente</small>
                                </div>
                            </a>
                        </div>

                        <div class="col-12 col-md-6">
                            <a asp-controller="Produtos" asp-action="GetAdd"
                               class="quick-action-btn d-flex align-items-center p-3 rounded text-decoration-none quick-action-purple">
                                <div class="rounded d-flex align-items-center justify-content-center me-3 flex-shrink-0"
                                     style="width:2.5rem;height:2.5rem;background-color:#7c3aed;">
                                    <i class="bi bi-box-seam-fill text-white fs-5"></i>
                                </div>
                                <div>
                                    <p class="fw-medium mb-0 text-dark">Cadastrar Produto</p>
                                    <small class="text-muted">Adicionar novo item</small>
                                </div>
                            </a>
                        </div>

                        <div class="col-12 col-md-6">
                            <a asp-controller="Pedidos" asp-action="Create" class="quick-action-btn d-flex align-items-center p-3 rounded text-decoration-none quick-action-green">
                                <div class="bg-success rounded d-flex align-items-center justify-content-center me-3 flex-shrink-0"
                                     style="width:2.5rem;height:2.5rem;">
                                    <i class="bi bi-file-earmark-text-fill text-white fs-5"></i>
                                </div>
                                <div>
                                    <p class="fw-medium mb-0 text-dark">Cadastrar Orçamento</p>
                                    <small class="text-muted">Adicionar orçamento</small>
                                </div>
                            </a>
                        </div>

                        <div class="col-12 col-md-6">
                            <a asp-controller="PriceCustomer" asp-action="Index" class="quick-action-btn d-flex align-items-center p-3 rounded text-decoration-none quick-action-orange">
                                <div class="rounded d-flex align-items-center justify-content-center me-3 flex-shrink-0"
                                     style="width:2.5rem;height:2.5rem;background-color:#ea580c;">
                                    <i class="bi bi-tag-fill text-white fs-5"></i>
                                </div>
                                <div>
                                    <p class="fw-medium mb-0 text-dark">Cadastrar Preço</p>
                                    <small class="text-muted">Adicionar preço fixo p/ Cliente</small>
                                </div>
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>